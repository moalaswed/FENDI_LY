# MariaDB application connection (cPanel Database details)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanelprefix_fendi_catalog
DB_USER=your_cpanelprefix_fendi_user
DB_PASSWORD=replace-with-the-database-user-password

# Use only when the database provider explicitly requires TLS
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate a unique random secret for the admin session signing key
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
